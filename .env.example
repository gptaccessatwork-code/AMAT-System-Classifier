# Copy this file to .env and adjust values for the host PC.
AMAT_MATCHER_HOST=0.0.0.0
AMAT_MATCHER_PORT=8080
AMAT_MATCHER_ROUTE=/
AMAT_MATCHER_MAX_UPLOAD_MB=50
AMAT_MATCHER_WORKERS=10

# Users enter their own Agile credentials in the sign-in screen.
# Credentials remain in the in-memory server session and are never saved.
AMAT_AGILE_WSDL_URL=http://pagapps1.ichorsystems.com:7001/CoreService/services/Table?wsdl
